# Discord Developer Portal > OAuth2 に同じRedirect URIを登録します。
# Client Secretはサーバー専用。VITE_変数やGitには保存しないでください。
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8080/api/admin/callback
ADMIN_DISCORD_USER_IDS=

# HTTPS公開時は true
SECURE_COOKIE=false
# Dockerでは /app/data/bingo.json が既定。ファイル単体ではなく親ディレクトリを永続化します。
# BINGO_DATA=/app/data/bingo.json
